# vim: set filetype=sh tabstop=2 softtabstop=2 shiftwidth=2
# Skip /etc/zprofile and /etc/zshrc: path_helper and the system prompt setup
# are not needed, and skipping them saves a few ms per shell.
setopt no_global_rcs

# /etc/zshrc used to set this.
setopt COMBINING_CHARS

# Ensure that a non-login, non-interactive shell has a defined environment.
if [[ ("$SHLVL" -eq 1 && ! -o LOGIN) && -s "${HOME}/.zprofile" ]]; then
  source "${HOME}/.zprofile"
fi

# fpath lives here, not in ~/.zprofile: every shell needs the same fpath or the
# completion dump is rebuilt on every login/non-login switch.
typeset -gU fpath path cdpath
fpath=(
  $HOME/.local/share/zsh/site-functions
  /Applications/Ghostty.app/Contents/Resources/zsh/site-functions
  /opt/homebrew/share/zsh/site-functions
  $fpath
)
