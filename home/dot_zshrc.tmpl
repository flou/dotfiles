# vim: set filetype=sh tabstop=2 softtabstop=2 shiftwidth=2

# OSC 133 semantic prompt markers (FinalTerm shell integration):
#   A = prompt start, B = user input start, C = command started, D = command done.
if (( ! $+_ghostty_state )); then
  typeset -gi _osc133_running=0

  _osc133_preexec() {
    _osc133_running=1
    printf '\e]133;C\a'
  }

  _osc133_precmd() {
    local -i exit_code=$?
    # Don't emit anything when precmd is invoked from zle (e.g. prompt refresh)
    if zle; then return 0; fi
    if (( _osc133_running )); then
      _osc133_running=0
      printf '\e]133;D;%d\a' "$exit_code"
    fi
    # Blank line between command output and prompt. Emitted here rather than
    # via starship's add_newline so the OSC 133 A mark starts the prompt line
    # instead of the empty line above it.
    print
  }

  preexec_functions=(_osc133_preexec ${preexec_functions:#_osc133_preexec})
  precmd_functions=(_osc133_precmd ${precmd_functions:#_osc133_precmd})

  PROMPT=$'%{\e]133;A\a%}%F{yellow}%~%f %{\e]133;B\a%}'
else
  PROMPT='%F{yellow}%~%f '
fi

setopt autocd
setopt extendedglob
setopt bang_hist               # Treat the '!' character specially during expansion.
setopt extended_history        # Write the history file in the ':start:elapsed;command' format.
setopt hist_expire_dups_first  # Expire a duplicate event first when trimming history.
setopt hist_find_no_dups       # Do not display a previously found event.
setopt hist_ignore_all_dups    # Delete an old recorded event if a new event is a duplicate.
setopt hist_ignore_dups        # Do not record an event that was just recorded again.
setopt hist_ignore_space       # Do not record an event starting with a space.
setopt hist_reduce_blanks      # Remove extra blanks from commands added to the history list.
setopt hist_save_no_dups       # Do not write a duplicate event to the history file.
setopt hist_verify             # Do not execute immediately upon history expansion.
setopt share_history           # Share history between sessions (implies inc_append_history).
setopt NO_hist_beep            # Don't beep when accessing non-existent history.
setopt hist_fcntl_lock         # /etc/zshrc set this; keep concurrent shells safe.

# /etc/zshrc used to set this. Needed because widgets.sh uses the emacs keymap.
bindkey -e
KEYTIMEOUT=1 # default 40 = 400ms; alt-h/alt-w/alt-g feel laggy

HISTFILE="${XDG_DATA_HOME}/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
# With share_history every shell reads this file at startup, so a very large
# HISTSIZE directly costs prompt latency. 100k is ~months of use.
HISTSIZE=100000
SAVEHIST=100000
HISTORY_IGNORE="(ls|l|cd|pwd|exit|cd ..|..)"

# Load antidote and ZSH plugins
zsh_plugins="${XDG_CONFIG_HOME}/zsh/zsh_plugins"
fpath=("${HOME}/.antidote/functions" $fpath)
autoload -Uz antidote

zstyle ':zephyr:plugin:completion' use-cache yes

# Generate a new static file whenever .zsh_plugins.txt is updated. Write to a
# temp file first so a failed antidote run cannot truncate the existing bundle.
if [[ ! "${zsh_plugins}.zsh" -nt "${zsh_plugins}.txt" ]]; then
  tmp="${zsh_plugins}.zsh.tmp.$$"
  if antidote bundle < "${zsh_plugins}.txt" >| "${tmp}"; then
    mv "${tmp}" "${zsh_plugins}.zsh"
  else
    rm -f "${tmp}"
  fi
fi
source "${zsh_plugins}.zsh"

# Aliases, widgets, work helpers, eza aliases and the venv hook are cheap and
# needed by the first command
source "${XDG_CONFIG_HOME}/zsh/aliases.sh"
if [[ -r "${XDG_CONFIG_HOME}/zsh/work-aliases.sh" ]]; then
  source "${XDG_CONFIG_HOME}/zsh/work-aliases.sh"
fi
source "${XDG_CONFIG_HOME}/zsh/widgets.sh"
if (($+commands[eza])); then
  source "${XDG_CONFIG_HOME}/zsh/eza.sh"
fi
if [[ -r "${XDG_CONFIG_HOME}/zsh/python-venv.sh" ]]; then
  source "${XDG_CONFIG_HOME}/zsh/python-venv.sh"
fi

# mise must be active before the first command so its tools are on PATH
if (($+commands[mise])); then
  zsh-defer -12p -c '. <(mise activate zsh)'
fi

if (($+commands[fzf])); then
  zsh-defer -12dmp -t 0.05 -c '. <(fzf --zsh)'
  zsh-defer -12dmp -c '. "${XDG_CONFIG_HOME}/fzf/ghq.sh"'
fi

if (($+commands[vivid])); then
  zsh-defer -12dmp -c 'export LS_COLORS="$(vivid generate molokai)"'
fi

# autoload -z edit-command-line
# zle     -N              edit-command-line
# bindkey -M emacs "^X^E" edit-command-line

# Cache a static init script, keyed by the resolved binary path and its mtime.
# Returns non-zero when the cache could not be (re)generated, so the caller can
# fall back to running the command directly.
_zsh_cache_init() {
  local bin=$commands[$1] file=$2 sig
  shift 2
  [[ -s $file ]] && read -r sig < $file
  if [[ $sig != "# $bin" || $bin -nt $file ]]; then
    mkdir -p "$file:h"
    if { print -r -- "# $bin"; "$bin" "$@" } >| "$file.tmp.$$" \
      && mv "$file.tmp.$$" "$file"; then
      :
    else
      rm -f "$file.tmp.$$"
      return 1
    fi
  fi
  source "$file"
}

if (($+commands[starship])); then
  if ! _zsh_cache_init starship "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship.zsh" init zsh; then
    eval "$($commands[starship] init zsh)"
  fi

  # Hardcode the continuation prompt (starship's is a fixed grey bullet) instead
  # of forking `starship prompt --continuation` and caching the result. Caching
  # it keyed on the binary would also go stale whenever starship.toml changes.
  PROMPT2='%F{240}∙%f '

  STARSHIP_SESSION_KEY="${RANDOM}${RANDOM}${RANDOM}${RANDOM}${RANDOM}0000000000000000"
  export STARSHIP_SESSION_KEY="${STARSHIP_SESSION_KEY:0:16}"

  if (( ! $+_ghostty_state )); then
    PROMPT=$'%{\e]133;A\a%}'"$PROMPT"$'%{\e]133;B\a%}'
  fi
fi

if (($+commands[direnv])); then
  if ! _zsh_cache_init direnv "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/direnv.zsh" hook zsh; then
    eval "$($commands[direnv] hook zsh)"
  fi

  if (( $+functions[_direnv_hook] && ! $+functions[_direnv_hook_orig] )); then
    functions[_direnv_hook_orig]=$functions[_direnv_hook]
    _direnv_hook() {
      setopt localoptions localtraps
      [[ -o interactive && $ZSH_SUBSHELL -eq 0 ]] || return 0
      if [[ -z $DIRENV_DIFF ]]; then
        local dir=$PWD
        while [[ $dir != / && ! -e $dir/.envrc ]]; do dir=${dir:h}; done
        [[ $dir == / && ! -e /.envrc ]] && return 0
      fi
      _direnv_hook_orig
    }
  fi
fi

if (($+commands[zsh-patina])); then
  zsh-defer -12dmp -c '. <(zsh-patina activate)'
fi
