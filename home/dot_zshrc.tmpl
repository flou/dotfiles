# vim: set filetype=sh tabstop=2 softtabstop=2 shiftwidth=2

# OSC 133 marks: A prompt start, B input start, C command start, D command done.
# Ghostty emits them itself and must keep its precmd hook last, so only install
# ours when it is not active.
typeset -gi _osc133_status=0
autoload -Uz add-zsh-hook

if (( ! $+_ghostty_state )); then
  typeset -gi _osc133_running=0

  _osc133_preexec() {
    _osc133_running=1
    printf '\e]133;C\a'
  }

  _osc133_precmd() {
    local -i exit_code=$?
    _osc133_status=$exit_code
    # Not during a zle refresh: the command is still running.
    if zle; then
      return $exit_code
    fi
    if (( _osc133_running )); then
      _osc133_running=0
      printf '\e]133;D;%d\a' "$exit_code"
    fi
    return $exit_code
  }

  add-zsh-hook preexec _osc133_preexec
  add-zsh-hook precmd _osc133_precmd
else
  # Ghostty owns the marks, but starship clobbers $? before _ghostty_precmd
  # (which must stay last). Capture it here, restore it at the end of the file.
  _osc133_capture_precmd() {
    local -i ret=$?
    _osc133_status=$ret
    return $ret
  }
  add-zsh-hook precmd _osc133_capture_precmd
fi

# Fallback prompt until starship replaces it; the A/B marks are added below.
PROMPT='%F{yellow}%~%f '

setopt autocd
setopt extendedglob
setopt bang_hist
setopt extended_history
setopt hist_expire_dups_first
setopt hist_find_no_dups
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt hist_verify
setopt share_history
setopt NO_hist_beep
setopt hist_fcntl_lock

bindkey -e
KEYTIMEOUT=10 # 100ms; 1 (10ms) is snappier but splits Alt chords over SSH/tmux

HISTFILE="${XDG_DATA_HOME}/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
# share_history reads this on every startup; 100k is ~months of use.
HISTSIZE=100000
SAVEHIST=100000
HISTORY_IGNORE="(ls|l|cd|pwd|exit|cd ..|..)"

zsh_plugins="${XDG_CONFIG_HOME}/zsh/zsh_plugins"
fpath=("${HOME}/.antidote/functions" $fpath)
autoload -Uz antidote

# zephyr caches compinit; avoid a full fpath scan per shell.
zstyle ':zephyr:plugin:completion' use-cache yes

# Rebuild the static bundle when .zsh_plugins.txt changes; the temp file keeps
# a failed run from truncating the existing one.
if [[ ! "${zsh_plugins}.zsh" -nt "${zsh_plugins}.txt" ]]; then
  tmp="${zsh_plugins}.zsh.tmp.$$"
  if antidote bundle < "${zsh_plugins}.txt" >| "${tmp}"; then
    mv "${tmp}" "${zsh_plugins}.zsh"
  else
    rm -f "${tmp}"
  fi
fi
source "${zsh_plugins}.zsh"

# Load eagerly: the first command needs these, and zsh-defer never runs under
# `zsh -i -c`.
source "${XDG_CONFIG_HOME}/zsh/aliases.sh"
if [[ -r "${XDG_CONFIG_HOME}/zsh/work-aliases.sh" ]]; then
  source "${XDG_CONFIG_HOME}/zsh/work-aliases.sh"
fi
source "${XDG_CONFIG_HOME}/zsh/widgets.sh"
if (($+commands[eza])) && [[ -r "${XDG_CONFIG_HOME}/zsh/eza.sh" ]]; then
  source "${XDG_CONFIG_HOME}/zsh/eza.sh"
fi
# Disabled while testing mise's uv_venv_auto; re-enable with uv_venv_auto = false.
# if [[ -r "${XDG_CONFIG_HOME}/zsh/python-venv.sh" ]]; then
#   source "${XDG_CONFIG_HOME}/zsh/python-venv.sh"
# fi

# uv_venv_auto needs hook-based activation, but mise's precmd hook forks
# `mise hook-env` (~19ms) on every prompt, so drop it and keep only the guarded
# chpwd hook. Activate eagerly in a project dir (deferred would race the first
# command), otherwise defer: activation costs ~40ms.
_zsh_mise_project_root() {
  # REPLY = nearest dir with a uv.lock/mise.toml, empty if none.
  local d=$PWD
  while [[ $d != / && ! -e $d/uv.lock && ! -e $d/mise.toml && ! -e $d/.mise.toml ]]; do
    d=${d:h}
  done
  [[ $d == / ]] && { REPLY=; return 1 }
  REPLY=$d
}

_zsh_mise_activate() {
  eval "$(mise activate zsh)"
  add-zsh-hook -d precmd _mise_hook_precmd
  _zsh_mise_project_root
  typeset -g _zsh_mise_root=$REPLY

  # Only fork when the nearest project root changes; otherwise every `cd` pays
  # the ~28ms `mise hook-env`.
  if (( $+functions[_mise_hook_chpwd] && ! $+functions[_zsh_mise_hook_chpwd_orig] )); then
    functions[_zsh_mise_hook_chpwd_orig]=$functions[_mise_hook_chpwd]
    _mise_hook_chpwd() {
      local -i ret=$?
      _zsh_mise_project_root
      if [[ $REPLY != $_zsh_mise_root ]]; then
        _zsh_mise_root=$REPLY
        _zsh_mise_hook_chpwd_orig
      fi
      return $ret
    }
  fi
}

if (($+commands[mise])); then
  if _zsh_mise_project_root; then
    _zsh_mise_activate
  else
    zsh-defer -12p -c '_zsh_mise_activate'
  fi
fi

# -12: show errors. -d -m: no chpwd/precmd hooks after the task. -p: no prompt
# redraw (it would fork starship again). -t: delay without blocking zle.
if (($+commands[fzf])); then
  zsh-defer -12dmp -t 0.05 -c '. <(fzf --zsh)'
  zsh-defer -12dmp -c '. "${XDG_CONFIG_HOME}/fzf/ghq.sh"'
fi

if (($+commands[vivid])); then
  zsh-defer -12dmp -c 'export LS_COLORS="$(vivid generate molokai)"'
fi

# autoload -z edit-command-line
# zle     -N              edit-command-line
# bindkey -M emacs "^X^E" edit-command-line

# Cache a static init script, keyed by binary path and mtime. The path matters
# for nix binaries: the store path changes on upgrade while the symlink target's
# epoch mtime means `-nt` never fires. Returns non-zero if generation fails.
_zsh_cache_init() {
  local bin=$commands[$1] file=$2 sig
  shift 2
  [[ -s $file ]] && read -r sig < $file
  if [[ $sig != "# $bin" || $bin -nt $file ]]; then
    mkdir -p "$file:h"
    # Scope pipefail to the pipeline, not with local_options: the sourced file
    # must still be able to set options (starship runs `setopt promptsubst`).
    local -i had_pipefail=$options[pipefail]
    setopt pipefail
    {
      # Drop starship's PROMPT2 fork; PROMPT2 is hardcoded below.
      if { print -r -- "# $bin"; "$bin" "$@" | sed '/^PROMPT2=/d' } >| "$file.tmp.$$" \
        && mv "$file.tmp.$$" "$file"; then
        :
      else
        rm -f "$file.tmp.$$"
        return 1
      fi
    } always {
      (( had_pipefail )) || unsetopt pipefail
    }
  fi
  source "$file"
}

if (($+commands[starship])); then
  # PROMPT must exist before the first prompt, so load eagerly; the init output
  # is static apart from the session key, so cache it.
  if ! _zsh_cache_init starship "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship.zsh" init zsh; then
    eval "$($commands[starship] init zsh)"
  fi

  # Hardcode the fixed continuation prompt instead of forking on startup.
  PROMPT2='%F{240}∙%f '
fi

# starship's PROMPT drops our A/B marks; re-add them. The newline comes before
# A so the mark starts the prompt line. In Ghostty its own A lands on the blank
# line instead, but its precmd hook must stay last.
if (( ! $+_ghostty_state )); then
  PROMPT=$'\n%{\e]133;A\a%}'"$PROMPT"$'%{\e]133;B\a%}'
else
  PROMPT=$'\n'"$PROMPT"
fi

if (($+commands[direnv])); then
  # Static hook: cache it and load eagerly so the first command sees the env.
  if ! _zsh_cache_init direnv "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/direnv.zsh" hook zsh; then
    eval "$($commands[direnv] hook zsh)"
  fi

  # Skip the ~10ms `direnv export` fork when no .envrc applies and nothing is
  # loaded; DIRENV_DIFF covers leaving a direnv directory.
  if (( $+functions[_direnv_hook] && ! $+functions[_direnv_hook_orig] )); then
    functions[_direnv_hook_orig]=$functions[_direnv_hook]
    _direnv_hook() {
      # Preserve $? for _osc133_precmd and starship.
      local -i ret=$?
      setopt localoptions localtraps
      [[ -o interactive && $ZSH_SUBSHELL -eq 0 ]] || return $ret
      if [[ -z $DIRENV_DIFF ]]; then
        local dir=$PWD
        while [[ $dir != / && ! -e $dir/.envrc ]]; do dir=${dir:h}; done
        [[ $dir == / && ! -e /.envrc ]] && return $ret
      fi
      _direnv_hook_orig
      return $ret
    }
  fi
fi

if (($+commands[zsh-patina])); then
  zsh-defer -12dmp -c '. <(zsh-patina activate)'
fi

# zsh-autosuggestions leaves its own status; preserve the command's for starship.
if (( $+functions[_zsh_autosuggest_start] && ! $+functions[_zsh_autosuggest_start_orig] )); then
  functions[_zsh_autosuggest_start_orig]=$functions[_zsh_autosuggest_start]
  _zsh_autosuggest_start() {
    local -i ret=$?
    _zsh_autosuggest_start_orig
    return $ret
  }
fi

# starship's precmd also loses $?; hand it back to Ghostty, which runs last.
if (( $+_ghostty_state )); then
  _osc133_restore_precmd() { return $_osc133_status }
  add-zsh-hook precmd _osc133_restore_precmd
fi
