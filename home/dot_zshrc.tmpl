# vim: set filetype=sh tabstop=2 softtabstop=2 shiftwidth=2

# OSC 133 semantic prompt markers (FinalTerm shell integration):
#   A = prompt start, B = user input start, C = command started, D = command done.
# Terminals that understand them (Rex, Ghostty, iTerm2, Kitty, WezTerm, ...) can
# jump between prompts/commands and track exit status. Ghostty injects the same
# marks itself and needs to remain the last precmd hook, so only install ours
# when its integration is not active.
typeset -gi _osc133_status=0
autoload -Uz add-zsh-hook

if (( ! $+_ghostty_state )); then
  typeset -gi _osc133_running=0

  _osc133_preexec() {
    _osc133_running=1
    printf '\e]133;C\a'
  }

  _osc133_precmd() {
    # Capture $? before anything else: later precmd hooks (starship) read it.
    local -i exit_code=$?
    _osc133_status=$exit_code
    # Don't emit anything when precmd is invoked from zle (prompt refresh), or
    # we would close a command that is still running.
    if zle; then
      return $exit_code
    fi
    if (( _osc133_running )); then
      _osc133_running=0
      printf '\e]133;D;%d\a' "$exit_code"
    fi
    return $exit_code
  }

  add-zsh-hook preexec _osc133_preexec
  add-zsh-hook precmd _osc133_precmd
else
  # Ghostty writes the OSC 133 marks itself, but starship's precmd clobbers $?
  # before _ghostty_precmd (which must stay last). Remember the status here and
  # put it back with _osc133_restore_precmd at the end of this file.
  _osc133_capture_precmd() {
    local -i ret=$?
    _osc133_status=$ret
    return $ret
  }
  add-zsh-hook precmd _osc133_capture_precmd
fi

# Prompt used until starship replaces it below, and the fallback when starship
# is not installed. The OSC 133 A/B marks are added once, after starship runs.
PROMPT='%F{yellow}%~%f '

setopt autocd
setopt extendedglob
setopt bang_hist               # Treat the '!' character specially during expansion.
setopt extended_history        # Write the history file in the ':start:elapsed;command' format.
setopt hist_expire_dups_first  # Expire a duplicate event first when trimming history.
setopt hist_find_no_dups       # Do not display a previously found event.
setopt hist_ignore_all_dups    # Delete an old recorded event if a new event is a duplicate.
setopt hist_ignore_dups        # Do not record an event that was just recorded again.
setopt hist_ignore_space       # Do not record an event starting with a space.
setopt hist_reduce_blanks      # Remove extra blanks from commands added to the history list.
setopt hist_save_no_dups       # Do not write a duplicate event to the history file.
setopt hist_verify             # Do not execute immediately upon history expansion.
setopt share_history           # Share history between sessions (implies inc_append_history).
setopt NO_hist_beep            # Don't beep when accessing non-existent history.
setopt hist_fcntl_lock         # /etc/zshrc set this; keep concurrent shells safe.

# /etc/zshrc used to set this. Needed because widgets.sh uses the emacs keymap.
bindkey -e
KEYTIMEOUT=10 # 100ms; 1 (10ms) is snappier but splits Alt chords over SSH/tmux

HISTFILE="${XDG_DATA_HOME}/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
# With share_history every shell reads this file at startup, so a very large
# HISTSIZE directly costs prompt latency. 100k is ~months of use.
HISTSIZE=100000
SAVEHIST=100000
HISTORY_IGNORE="(ls|l|cd|pwd|exit|cd ..|..)"

# Load antidote and ZSH plugins
zsh_plugins="${XDG_CONFIG_HOME}/zsh/zsh_plugins"
fpath=("${HOME}/.antidote/functions" $fpath)
autoload -Uz antidote

# zephyr already knows how to cache compinit; enable it (20h TTL) instead of
# running a full fpath scan on every shell.
zstyle ':zephyr:plugin:completion' use-cache yes

# Generate a new static file whenever .zsh_plugins.txt is updated. Write to a
# temp file first so a failed antidote run cannot truncate the existing bundle.
if [[ ! "${zsh_plugins}.zsh" -nt "${zsh_plugins}.txt" ]]; then
  tmp="${zsh_plugins}.zsh.tmp.$$"
  if antidote bundle < "${zsh_plugins}.txt" >| "${tmp}"; then
    mv "${tmp}" "${zsh_plugins}.zsh"
  else
    rm -f "${tmp}"
  fi
fi
source "${zsh_plugins}.zsh"

# Aliases, widgets, work helpers, eza aliases and the venv hook are cheap and
# needed by the first command (and by `zsh -i -c` invocations, where zsh-defer
# never runs): load them eagerly. zsh-defer comes from the antidote bundle
# sourced above.
source "${XDG_CONFIG_HOME}/zsh/aliases.sh"
if [[ -r "${XDG_CONFIG_HOME}/zsh/work-aliases.sh" ]]; then
  source "${XDG_CONFIG_HOME}/zsh/work-aliases.sh"
fi
source "${XDG_CONFIG_HOME}/zsh/widgets.sh"
if (($+commands[eza])); then
  source "${XDG_CONFIG_HOME}/zsh/eza.sh"
fi
# Disabled while testing mise's python.uv_venv_auto (see
# ~/.config/mise/config.toml). Re-enable this block and set uv_venv_auto = false
# to switch back to the chpwd-based hook.
# if [[ -r "${XDG_CONFIG_HOME}/zsh/python-venv.sh" ]]; then
#   source "${XDG_CONFIG_HOME}/zsh/python-venv.sh"
# fi

# mise's shims (in ~/.zprofile) cover tool paths, but python.uv_venv_auto and
# per-project [env] only apply in a hook-activated shell, so activate for real.
# mise's precmd hook forks `mise hook-env` (~19ms here) on every prompt, so drop
# it; the chpwd hook and the initial `_mise_hook --force` in the activate script
# cover dir changes and shell start.
#
# Activation costs ~40ms (fork for `mise activate`, fork for its initial hook,
# plus venv detection), so only pay it up front when the shell starts inside a
# project; a deferred activation would otherwise race the first command.
_zsh_mise_project_root() {
  # REPLY = nearest directory with a uv.lock/mise.toml, empty if none.
  local d=$PWD
  while [[ $d != / && ! -e $d/uv.lock && ! -e $d/mise.toml && ! -e $d/.mise.toml ]]; do
    d=${d:h}
  done
  [[ $d == / ]] && { REPLY=; return 1 }
  REPLY=$d
}

_zsh_mise_activate() {
  eval "$(mise activate zsh)"
  add-zsh-hook -d precmd _mise_hook_precmd
  _zsh_mise_project_root
  typeset -g _zsh_mise_root=$REPLY

  # mise's chpwd hook forks `mise hook-env` (~28ms here) on every cd, even
  # outside a project. Run it only when the nearest project root changes, so
  # `cd` within a project (or anywhere unrelated) stays free.
  if (( $+functions[_mise_hook_chpwd] && ! $+functions[_zsh_mise_hook_chpwd_orig] )); then
    functions[_zsh_mise_hook_chpwd_orig]=$functions[_mise_hook_chpwd]
    _mise_hook_chpwd() {
      local -i ret=$?
      _zsh_mise_project_root
      if [[ $REPLY != $_zsh_mise_root ]]; then
        _zsh_mise_root=$REPLY
        _zsh_mise_hook_chpwd_orig
      fi
      return $ret
    }
  fi
}

if (($+commands[mise])); then
  if _zsh_mise_project_root; then
    _zsh_mise_activate
  else
    zsh-defer -12p -c '_zsh_mise_activate'
  fi
fi

# Cosmetic integrations. -12dmp: show errors (-1 -2), skip precmd/chpwd hooks
# after each task (-m -d), and don't redraw the prompt (-p) -- every redraw
# re-runs starship. -t delays this task and everything after it without
# blocking ZLE, so put it on the first cosmetic task only.
if (($+commands[fzf])); then
  zsh-defer -12dmp -t 0.05 -c '. <(fzf --zsh)'
  zsh-defer -12dmp -c '. "${XDG_CONFIG_HOME}/fzf/ghq.sh"'
fi

if (($+commands[vivid])); then
  zsh-defer -12dmp -c 'export LS_COLORS="$(vivid generate molokai)"'
fi

# autoload -z edit-command-line
# zle     -N              edit-command-line
# bindkey -M emacs "^X^E" edit-command-line

# Cache a static init script, keyed by the resolved binary path and its mtime.
# Returns non-zero when the cache could not be (re)generated, so the caller can
# fall back to running the command directly.
#
# The header records which binary produced the cache. Comparing the path as well
# as the mtime matters for nix-installed binaries, whose symlink target has an
# epoch mtime (so `-nt` never fires) but whose store path changes on upgrade.
_zsh_cache_init() {
  # pipefail: a failing binary must not leave a truncated cache behind just
  # because sed exited successfully.
  setopt local_options pipefail
  local bin=$commands[$1] file=$2 sig
  shift 2
  [[ -s $file ]] && read -r sig < $file
  if [[ $sig != "# $bin" || $bin -nt $file ]]; then
    mkdir -p "$file:h"
    # starship's init forks `starship prompt --continuation` for PROMPT2; drop
    # that line (PROMPT2 is hardcoded below) so caching really avoids the fork.
    if { print -r -- "# $bin"; "$bin" "$@" | sed '/^PROMPT2=/d' } >| "$file.tmp.$$" \
      && mv "$file.tmp.$$" "$file"; then
      :
    else
      rm -f "$file.tmp.$$"
      return 1
    fi
  fi
  source "$file"
}

if (($+commands[starship])); then
  # PROMPT must exist before the first prompt, so starship has to load eagerly.
  # `starship init zsh` is static apart from the session key, which it generates
  # at source time, so cache it: a ~10ms starship fork collapses into one file
  # read. _zsh_cache_init strips the PROMPT2 fork for us.
  if ! _zsh_cache_init starship "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/starship.zsh" init zsh; then
    eval "$($commands[starship] init zsh)"
  fi

  # Hardcode the continuation prompt (starship's is a fixed grey bullet) instead
  # of forking `starship prompt --continuation`. Caching it keyed on the binary
  # would also go stale whenever starship.toml changes.
  PROMPT2='%F{240}∙%f '
fi

# starship replaces PROMPT, dropping the OSC 133 A/B marks. Put them back here,
# once, for both starship and the fallback prompt above. The A mark belongs on
# the prompt line itself, which is why starship.toml keeps add_newline = false
# and no precmd hook prints a leading blank line.
if (( ! $+_ghostty_state )); then
  PROMPT=$'%{\e]133;A\a%}'"$PROMPT"$'%{\e]133;B\a%}'
fi

if (($+commands[direnv])); then
  # The hook is static (it only embeds the direnv path), so cache it and load it
  # eagerly: the first command then always sees the right environment. direnv
  # itself still runs from precmd/chpwd, exactly as designed.
  if ! _zsh_cache_init direnv "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/direnv.zsh" hook zsh; then
    eval "$($commands[direnv] hook zsh)"
  fi

  # Fast path: `direnv export zsh` costs ~10ms per prompt even when there is no
  # .envrc. Skip the fork when nothing is loaded and no .envrc exists above us;
  # DIRENV_DIFF is set whenever direnv has an environment to unload, so leaving
  # a direnv directory still works.
  if (( $+functions[_direnv_hook] && ! $+functions[_direnv_hook_orig] )); then
    functions[_direnv_hook_orig]=$functions[_direnv_hook]
    _direnv_hook() {
      # `direnv hook zsh` prepends this hook to precmd_functions, so it runs
      # before _osc133_precmd and starship. Preserve $? or both see this hook's
      # status instead of the command that just ran.
      local -i ret=$?
      setopt localoptions localtraps
      [[ -o interactive && $ZSH_SUBSHELL -eq 0 ]] || return $ret
      if [[ -z $DIRENV_DIFF ]]; then
        local dir=$PWD
        while [[ $dir != / && ! -e $dir/.envrc ]]; do dir=${dir:h}; done
        [[ $dir == / && ! -e /.envrc ]] && return $ret
      fi
      _direnv_hook_orig
      return $ret
    }
  fi
fi

if (($+commands[zsh-patina])); then
  zsh-defer -12dmp -c '. <(zsh-patina activate)'
fi

# zsh-autosuggestions rebinds widgets on every prompt and leaves $? set to its
# own status. Preserve the command's status for starship, which runs after it.
if (( $+functions[_zsh_autosuggest_start] && ! $+functions[_zsh_autosuggest_start_orig] )); then
  functions[_zsh_autosuggest_start_orig]=$functions[_zsh_autosuggest_start]
  _zsh_autosuggest_start() {
    local -i ret=$?
    _zsh_autosuggest_start_orig
    return $ret
  }
fi

# starship's precmd does not preserve $? either. In Ghostty, _ghostty_precmd
# must be the last precmd hook, so hand the status back to it here.
if (( $+_ghostty_state )); then
  _osc133_restore_precmd() { return $_osc133_status }
  add-zsh-hook precmd _osc133_restore_precmd
fi
