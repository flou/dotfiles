"$schema" = 'https://starship.rs/config-schema.json'

# Modules are only evaluated if referenced in `format`.
# add_newline = false: ~/.zshrc adds the blank line, after the OSC 133 A mark.
add_newline = false
format = "$username$hostname$localip$shlvl$directory$git_branch$helm$python$terraform$zig$nix_shell$aws$gcloud$direnv$kubernetes$sudo$cmd_duration$line_break$jobs$battery$shell$character"

[directory]
truncation_length = 0
read_only = " 󰌾"

[character]
success_symbol = '[\$](green)'
error_symbol = '[\$](red)'

[aws]
disabled = {{ not .work }}
format = '$symbol:[$profile(\($region\))]($style) '
symbol = " "
style = "yellow"

[aws.region_aliases]
eu-north-1 = "SE"
eu-west-3 = "FR"
eu-west-1 = "IE"

[gcloud]
disabled = {{ not .work }}
format = '$symbol:[$account(\($region\))]($style) '
symbol = "gcp"
style = "blue"

[git_branch]
format = 'on [$branch]($style) '

{{- if .work }}
[kubernetes]
disabled = false
format = '[$symbol$context( \($namespace\))]($style) '
style = "purple"
{{- if stat (joinPath .chezmoi.homeDir ".config/starship/starship_k8s_contexts") }}
contexts = {{ include (joinPath .chezmoi.homeDir ".config/starship/starship_k8s_contexts") }}
{{- end -}}
{{- end }}

[python]
format = '[$symbol:${pyenv_prefix}${version}( \($virtualenv\))]($style) '
symbol = " "
style = "yellow"

[terraform]
format = "[$symbol:$workspace]($style) "
symbol = "󱁢 "

[zig]
symbol = " "

[hostname]
ssh_symbol = " "

[nix_shell]
symbol = " "
