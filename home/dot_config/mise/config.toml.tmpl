[settings]
experimental = true
legacy_version_file = false
disable_backends = ["asdf"]
minimum_release_age = "0s"
{{- if .work }}
trusted_config_paths = [
  "{{ .chezmoi.homeDir }}/workspace/{{ .my.work_git_forge }}/",
]
{{- end }}

[settings.npm]
bun = true

[settings.python]
uv_venv_auto = "create|source"

[settings.self_update]
auto = true

[tools]
aube = "latest"
cargo-binstall = "latest"
go = "latest"
just = "latest"
node = "latest"
python = "latest"
usage = "latest"
uv = "latest"
"pypi:pxpx" = "latest"
bun = "latest"
opencode = { version = "latest", allow_builds = ["@opencode/cli"] }
{{ if .work }}
"cargo:proc-cli" = "latest"
"go:github.com/rothgar/k" = "latest"
argocd = "latest"
aws-cli = "latest"
claude-code = "latest"
gcloud = "584.0.0"
hadolint = "latest"
helm = "latest"
helm-diff = "latest"
jq = "latest"
k9s = "latest"
kubectl = "latest"
kubectx = "latest"
prek = "latest"
shellcheck = "latest"
stern = "latest"
tflint = "latest"
vault = "1.18.2"
viddy = "latest"
yq = "latest"
{{ end }}
[bootstrap.services.mise-history]
builtin = "history-watch"

[dotfiles]
"~/.config/lazygit/config.yml" = { mode = "track" }
"~/.zprofile" = { mode = "track" }
"~/.zshenv" = { mode = "track" }
"~/.zshrc" = { mode = "track" }

[history]
exclude = [".DS_Store"]
