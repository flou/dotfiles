[settings]
experimental = true
minimum_release_age = "0s"
legacy_version_file = false
disable_backends = ["asdf"]
{{- if .work }}
trusted_config_paths = [
  "{{ .chezmoi.homeDir }}/workspace/{{ .my.work_git_forge }}/",
]
{{- end }}

[settings.npm]
bun = true

[settings.python]
compile = false
uv_venv_auto = "create|source"

[settings.self_update]
auto = true

[tools]
aube = "latest"
cargo-binstall = "latest"
go = "latest"
node = "latest"
python = "latest"
usage = "latest"
uv = "latest"
"pypi:pxpx" = "latest"
bun = "latest"
{{- if .work }}
"cargo:abtop" = "latest"
"cargo:proc-cli" = "latest"
"go:github.com/jackchuka/dutix/cmd/dutix" = "latest"
"go:github.com/rothgar/k" = "latest"
"npm:@tsuga/cli" = "latest"
"pypi:azure-cli" = "latest"
"pypi:commitizen" = "latest"
"pypi:keyring" = "latest"
argocd = "latest"
aws-cli = "latest"
claude-code = "latest"
crossplane = "latest"
gcloud = "592.0.0"
hadolint = "latest"
helm = "latest"
helm-diff = "latest"
hunk = "latest"
jq = "latest"
k9s = "latest"
kubectl = "latest"
kubectx = "latest"
lua-language-server = "latest"
pitchfork = "latest"
prek = "latest"
rtk = "latest"
shellcheck = "latest"
stern = "latest"
tflint = "latest"
vault = "latest"
viddy = "latest"
yq = "latest"
{{- else }}
opencode = { version = "latest", allow_builds = ["@opencode/cli"] }
{{- end }}

[bootstrap.services.mise-history]
builtin = "history-watch"

[dotfiles]
"~/.config/lazygit/config.yml" = { mode = "track" }
"~/.zprofile" = { mode = "track" }
"~/.zshenv" = { mode = "track" }
"~/.zshrc" = { mode = "track" }

[history]
exclude = [".DS_Store"]
